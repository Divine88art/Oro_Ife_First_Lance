* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #f8fafc;
    min-height: 100vh;
    overflow-x: hidden;
}

/* HERO SECTION */
.hero-section {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px;
    transition: transform 0.8s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease;
}

.hero-content h1 {
    font-size: 2.5rem;
    margin: 15px 0;
    background: linear-gradient(90deg, #ff7e5f, #feb47b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-content p {
    color: #94a3b8;
    margin-bottom: 30px;
    font-size: 1.1rem;
}

.badge {
    background: rgba(255, 126, 95, 0.15);
    color: #ff7e5f;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}

.btn-primary {
    padding: 16px 32px;
    background: linear-gradient(90deg, #ff7e5f, #feb47b);
    border: none;
    border-radius: 50px;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(255, 126, 95, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.btn-primary:hover {
    transform: translateY(-3px) scale(1.02);
}

/* SECTION FORMULAIRE (TRANSITION) */
.booking-section {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
    transition: all 0.8s cubic-bezier(0.77, 0, 0.175, 1);
}

.hidden {
    display: none;
    opacity: 0;
    transform: translateY(100px);
}

.slide-up {
    animation: slideUp 0.8s forwards;
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(80px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* CARTE GLASSMORPHISM */
.container {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 30px;
    width: 100%;
    max-width: 550px;
}

/* GRILLE DU MENU */
.menu-grid {
    display: grid;
    gap: 12px;
    margin-top: 10px;
}

.menu-card {
    background: rgba(15, 23, 42, 0.6);
    border: 2px solid #334155;
    border-radius: 14px;
    padding: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.menu-card:hover {
    border-color: #feb47b;
}

.menu-card.selected {
    border-color: #ff7e5f;
    background: rgba(255, 126, 95, 0.1);
}

.menu-card h3 {
    font-size: 1rem;
    color: #fff;
}

.menu-card .description {
    font-size: 0.8rem;
    color: #94a3b8;
    margin: 4px 0;
}

.menu-card .price {
    font-weight: 700;
    color: #feb47b;
    font-size: 0.95rem;
}

/* FORMULAIRE & TOTAL */
.form-group {
    margin-bottom: 18px;
}

label {
    display: block;
    font-size: 0.85rem;
    color: #cbd5e1;
    margin-bottom: 8px;
    font-weight: 600;
}

input {
    width: 100%;
    padding: 12px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid #334155;
    border-radius: 10px;
    color: #fff;
}

.total-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 15px;
}

.total-box strong {
    color: #ff7e5f;
    font-size: 1.2rem;
}

.btn-submit {
    width: 100%;
    padding: 16px;
    background: linear-gradient(90deg, #ff7e5f, #feb47b);
    border: none;
    border-radius: 12px;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
.site-logo {
    height: 60px; /* Ajuste la hauteur selon la taille de ton header */
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0px 2px 4px rgba(0, 0, 0, 0.4)); /* Fait ressortir le doré */
    transition: transform 0.3s ease;
}

.site-logo:hover {
    transform: scale(1.05); /* Effet de zoom au survol */
}

