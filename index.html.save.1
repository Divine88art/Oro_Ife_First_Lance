<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oro Ife Foods - Commande Express</title>
    <link rel="icon" type="image/svg" href="favicon.svg">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- 1. PAGE D'ACCUEIL (HERO SECTION) -->
    <section id="hero" class="hero-section">
        <div class="hero-content">
            <span class="badge">👨‍🍳 Bienvenue à ORO IFE Foods</span>
            <h1>Une cuisine authentique, livrée ou à emporter</h1>
            <p>Commandez vos plats préférés en quelques clics et gagnez du temps.</p>
            <button id="startBtn" class="btn-primary">Découvrir le Menu & Commander 🍲</button>
        </div>
    </section>

    <!-- 2. SECTION FORMULAIRE & MENU (MASQUÉE AU DÉPART) -->
    <section id="booking" class="booking-section hidden">
        <div class="container">
            <header>
               <h2>Votre Commande Express</h2>
                <p>Sélectionnez vos plats et validez l'heure de retrait</p>
            </header>

            <form id="orderForm">
                <div class="form-group">
                    <label>Choisissez vos plats</label>
                    <div class="menu-grid">
                        <div class="menu-card" data-name="Plat du Jour" data-price="3500">
                            <h3>Plat du Jour 🍲</h3>
                            <p class="description">Recette traditionnelle fraîchement préparée.</p>
                            <span class="price">3 500 FCFA</span>
                        </div>
                        <div class="menu-card" data-name="Menu Gourmand" data-price="5000">
                            <h3>Menu Gourmand 🍗</h3>
                            <p class="description">Accompagnement au choix + boisson offerte.</p>
                            <span class="price">5 000 FCFA</span>
                        </div>
                        <div class="menu-card" data-name="Spécialité Maison" data-price="6500">
                            <h3>Spécialité Maison 👑</h3>
                            <p class="description">Le chef-d'œuvre de notre cuisine.</p>
                            <span class="price">6 500 FCFA</span>
                        </div>
                    </div>
                </div> -->

	<section class="menu-container">
    	    <h2>Nos Spécialités</h2>
    	    <div class="menu-grid">
        <!-- Plat 1 -->
        <div class="dish-card" onclick="openDishModal('attieke')">
            <img src="attieke.jpg" alt="Attiékè" class="dish-img">
            <h3>Attiékè</h3>
        </div>
        <!-- Plat 2 -->
        <div class="dish-card" onclick="openDishModal('brunch')">
            <img src="brunch.jpg" alt="Pain Brunch" class="dish-img">
            <h3>Pain Brunch</h3>
        </div>
        <!-- Plat 3 -->
        <div class="dish-card" onclick="openDishModal('spaghetti')">
            <img src="spaghetti.jpg" alt="Spaghetti" class="dish-img">
            <h3>Spaghetti</h3>
        </div>
        <!-- Plat 4 -->
        <div class="dish-card" onclick="openDishModal('salade')">
            <img src="salade.jpg" alt="Salade" class="dish-img">
            <h3>Salade</h3>
        </div>
        <!-- Plat 5 -->
        <div class="dish-card" onclick="openDishModal('jollof')">
            <img src="jollof.jpg" alt="Riz jollof" class="dish-img">
            <h3>Riz jollof</h3>
        </div>
        <!-- Plat 6 -->
        <div class="dish-card" onclick="openDishModal('grillades')">
            <img src="grillades.jpg" alt="Grillades" class="dish-img">
            <h3>Grillades</h3>
        </div>
        <!-- Plat 7 -->
        <div class="dish-card" onclick="openDishModal('tchiep')">
            <img src="tchiep.jpg" alt="Tchiep" class="dish-img">
            <h3>Tchiep</h3>
        </div>
        <!-- Plat 8 -->
        <div class="dish-card" onclick="openDishModal('chawarma')">
            <img src="chawarma.jpg" alt="Chawarma" class="dish-img">
            <h3>Chawarma</h3>
        </div>
        <!-- Plat 9 -->
        <div class="dish-card" onclick="openDishModal('jus')">
            <img src="jus.jpg" alt="Jus Natures" class="dish-img">
            <h3>Jus Natures</h3>
        </div>
    </div>
</section>
                <!-- Informations Client -->
                <div class="form-group">
                    <label for="nom">Nom Complet</label>
                    <input type="text" id="nom" placeholder="Ex: Camille DuFleuve" required>
                </div>

                <div class="form-group">
                    <label for="telephone">Numéro WhatsApp</label>
                    <input type="tel" id="telephone" placeholder="Ex: +229 01 98 56 78 98" required>
                </div>

                <div class="form-group">
                    <label for="heure">Heure de retrait souhaitée</label>
                    <input type="time" id="heure" required>
                </div>

                <!-- Total dynamique -->
                <div class="total-box">
                    <span>Total estimé :</span>
                    <strong id="totalAmount">0 FCFA</strong>
                </div>

                <button type="submit" class="btn-submit">Valider via WhatsApp 🚀</button>
            </form>
        </div>
    </section>
<!-- Script officiel KKiaPay direct depuis le dashboard -->
    <script src="https://cdn.kkiapay.me/k.js"></script>

    <!-- Ton script JavaScript local -->
    <script src="script.js"></script>
<!-- Modal de sélection de plat -->
<div id="dishModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close-btn" onclick="closeDishModal()">&times;</span>
        <h2 id="modalDishName">Nom du plat</h2>
        <p id="modalDishDesc">Description du plat...</p>
        
        <!-- Formats prédéfinis -->
        <label>Choisissez un format :</label>
        <select id="priceSelect" onchange="toggleCustomPrice()">
            <option value="1500">Format 1 500 F CFA</option>
            <option value="2000">Format 2 000 F CFA</option>
            <option value="2500">Format 2 500 F CFA</option>
            <option value="3000">Format 3 000 F CFA</option>
            <option value="3500">Format 3 500 F CFA</option>
            <option value="4000">Format 4 000 F CFA</option>
            <option value="custom">Montant personnalisé (min. 1 000 F)</option>
        </select>

        <input type="number" id="customPriceInput" placeholder="Montant en FCFA" min="1000" style="display:none;">

        <!-- Option Jus Natures -->
        <div class="drink-option">
            <label><input type="checkbox" id="addDrink"> Ajouter un Jus Nature (+250 F CFA/bouteille)</label>
            <input type="number" id="drinkQty" value="1" min="1" style="display:none;">
        </div>

        <button onclick="addToCart()">Ajouter au panier 🛒</button>
    </div>
</div>
</body>
</html>
